# VEESIBI Environment Configuration

# Supabase Production Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google OAuth Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# PayPal Payment Gateway Credentials (Required for India & Cross-Border SaaS Billing)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here
PAYPAL_MODE=sandbox # Use 'sandbox' for testing or 'live' for production

# Rate Limiting & Edge Redis (Optional - In-Memory Fallback Active by Default)
UPSTASH_REDIS_REST_URL=https://your-redis-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# AI API Providers (Optional for Live Multi-Engine Citations)
OPENAI_API_KEY=sk-proj-your-openai-key
DATAFORSEO_API_KEY=your-dataforseo-key
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Email Alerts (Optional - Console fallback if not set)
RESEND_API_KEY=re_your-resend-key
ALERT_EMAIL=you@example.com

# Cron Secret (Set this for production scheduled re-audits)
CRON_SECRET=your-random-cron-secret
